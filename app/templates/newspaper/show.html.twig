{% extends 'base.html.twig' %}

{% block title %}
    {{ newspaper.title }} | Szczegóły newspaper
{% endblock %}
{% block body %}
    <a style="float:right;" class="btn btn-outline-primary me-2" href="{{ url('newspaper_index') }}" title="{{ 'action.back_to_list'|trans }}">
        {{ 'action.back_to_list'|trans }}
    </a>
    <h1>{{ newspaper.title }}</h1>
    <p>{{ 'label.category'|trans }}: <a class="btn btn-outline-primary me-2" href="{{ url('newspaper_index', {'categoryId': newspaper.category.id}) }}" title="{{ newspaper.category.title }}">
            {{ newspaper.category.title }}
        </a>
    </p>
    <p>{{ newspaper.content }}</p>
    <p>{{ 'label.tag'|trans }}:
    {% for tag in newspaper.tags %}
        <a class="btn btn-outline-primary" href="{{ url('newspaper_index', {'tagId': tag.id}) }}" title="{{ tag.title }}">
            {{ tag.title }}
        </a>
    {% endfor %}
    </p>
    <h2>{{ 'label.rating'|trans }}</h2>
        <p>
        {% if newspaper.averageRating is not null %}
            Średnia ocen: {{ newspaper.averageRating }} (Ilość ocen: {{ newspaper.ratings.count }} )
        {% else %}
            Brak ocen.
        {% endif %}
        </p>
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <a href="{{ path('newspaper_rate', {'id': newspaper.id}) }}" class="btn btn-primary">{{'action.rating_add'|trans}}</a>
    {% else %}

    {% endif %}
    {% if commentForm is not null %}
        <h2>Dodaj nowy komentarz</h2>
        <form method="post">
            {{ form_start(commentForm) }}
            <div class="form-group">
                {{ form_label(commentForm.content, 'label.comment') }}
                {{ form_widget(commentForm.content, {'attr': {'class': 'form-control', 'placeholder': 'label.content'}}) }}
            </div>
            <button style="margin-top: 10px;" class="btn btn-primary" type="submit">{{ button_label|default('action.create'|trans) }}</button>
            {{ form_end(commentForm) }}
        </form>
    {% else %}
        <p><a class="btn btn-outline-primary" href="{{ path('app_login') }}">{{ 'action.login'|trans }}</a> bądź <a class="btn btn-outline-primary" href="{{ path('user_register') }}">{{ 'action.register'|trans }}</a> aby komentować i oceniać.</p>
    {% endif %}
    <h2>Komentarze</h2>
    <ul>
        {% for comment in comments %}
            <li>
                <strong>{{ comment.author.email }}</strong>: {{ comment.createdAt|format_datetime(pattern='d MMMM y HH:mm', locale='pl') }}
                <br>
                <medium>{{ comment.content }}</medium>
                {% if is_granted('ROLE_ADMIN') %}
                    <form action="{{ path('comment_delete', {'newspaper_id': newspaper.id, 'id': comment.id}) }}" method="post" style="display: inline-block;">
                        <button class="btn btn-outline-danger" type="submit">Delete</button>
                    </form>
                {% endif %}
            </li>
        {% else %}
            <li>No comments yet.</li>
        {% endfor %}
    </ul>
{% endblock %}
